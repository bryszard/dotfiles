[alias]
  co = checkout
  ci = commit
  dci = duet-commit
  ph = push origin HEAD
  pl = pull origin
  st = status
  br = branch
  hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
  type = cat-file -t
  dump = cat-file -p
  ignored = !git ls-files -v | grep "^[[:lower:]]"
  histl = log --graph --pretty=format:'%Cred%h%Creset %w(72,1,2)%s -%C(yellow)%d%Creset %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
  histco = "!f() { git checkout `git rev-list -n 1 --first-parent --before='$1' master`; }; f"

date=relative  
[user]
	name = Brychu
	email = pbrych@gmail.com
[core]
	excludesfile = /Users/pedro/.gitignore_global
	ignorecase = true
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[diff "sopsdiffer"]
	textconv = sops -d
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	template = /Users/admin/.stCommitMsg
	verbose = true
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[push]
	followTags = true
	default = upstream
[includeif "gitdir:~/Work/"]
	path = .gitconfig.work
[rerere]
	enabled = true
	autoupdate = true
[pull]
	ff = only
[init]
	defaultBranch = main
[column]
        ui = never
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[diff]
	algorithm = histogram
	mnemonicPrefix = true
	renames = true
[push] 
	default = simple
	autoSetupRemote = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[rebase]
	autoStash = true
	updateRefs = true
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
